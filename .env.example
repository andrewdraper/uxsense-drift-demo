# UXSense recorder project id — copy from app.uxsense.ai → project → Connections.
# Set this in the deploy environment (Render/Vercel), not in the repo.
VITE_UXSENSE_PROJECT_ID=

# UXSense API key used only by `npx uxsense upload-manifest` after a build.
# Deploy-environment secret. Never commit a real value.
UXSENSE_API_KEY=
